# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env НЕ попадёт в репозиторий (он в .gitignore).
# На хостинге (Bothost) эти значения задаются в панели переменных окружения.

# ОБЯЗАТЕЛЬНО: токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# Канал куда постить (username с @ или числовой ID)
CHANNEL_ID=@your_channel

# Telegram ID администратора (узнать можно у @userinfobot)
ADMIN_ID=123456789

# Группа обсуждения и ветка (для режима отправки в ветку).
# Узнать ID: команда /chatinfo внутри нужной ветки.
DISCUSSION_CHAT_ID=-1001234567890
DISCUSSION_THREAD_ID=1

# Папка для данных (для постоянного хранилища на хостинге).
# Локально можно не указывать — данные будут в текущей папке.
# На хостинге с Volume укажите путь к примонтированному хранилищу.
# DATA_DIR=/data

# ============================================================
# ЁМКОСТЬ. Без этих переменных используются прежние значения —
# они рассчитаны на скромный сервер. Поднимать имеет смысл, только
# если ресурсы действительно свободны (см. /health и /doctor).
# ============================================================

# Сколько источников качаем одновременно. Сбор упирается в сеть, а не в ядра,
# поэтому значение может быть заметно больше числа vCPU. Каждый параллельный
# сбор — это до ~5 МБ ответа в памяти.
# SOURCE_FETCH_CONCURRENCY=5

# Сколько новостей берём с одного источника за проход.
# NEWS_PER_SOURCE=5

# Как часто обходим источники, секунд (минимум 300).
# CHECK_INTERVAL_SEC=1800

# Глубина очереди постов. Пороги backpressure считаются как доля от неё
# (2/3 и 9/10), поэтому подняв очередь, вы поднимаете и их.
# QUEUE_MAX_SIZE=30

# Длина истории публикаций для дедупа. 5000 URL занимают единицы мегабайт.
# SENT_LINKS_MAX=5000

# Фото в media group. Выше 10 не поднимется: это лимит Telegram, не сервера.
# MAX_PHOTOS_PER_POST=6

# Логи: размер файла и число ротаций.
# LOG_MAX_MB=5
# LOG_BACKUP_COUNT=3

# Куда качать видео. Нужно только если /tmp на хостинге — это tmpfs, то есть
# та же оперативная память: ролик на 48 МБ там съедает RAM, а не диск.
# Проверить: df -T /tmp. Если тип overlay/ext4 — переменная не нужна.
# VIDEO_DIR=/app/data/video

# Перекодирование видео через ffmpeg. Выключено по умолчанию именно как
# дорогая по CPU операция; включать при свободных ядрах и наличии ffmpeg.
# FEATURE_VIDEO_NORMALIZE=true

# Бюджет памяти под кеш скачанных картинок, МБ. Ограничение по числу записей
# (40 шт) само по себе ничего не гарантирует: при лимите загрузки в 9 МБ это
# до 360 МБ. Если контейнер маленький — уменьшайте в первую очередь это.
# IMAGE_BYTES_CACHE_MAX_MB=48

# Диагностика. Петля перезапусков определяется средним интервалом между
# стартами: если он меньше этого значения, бот пришлёт диагноз в личку.
# RESTART_LOOP_INTERVAL_SEC=300

# Порог, с которого блокировка event loop попадает в лог и метрики.
# EVENT_LOOP_LAG_WARN_MS=1000
# EVENT_LOOP_LAG_INTERVAL_SEC=1.0


# ============================================================
# ПРЕСЕТ: один бот, 2 ГБ RAM, 4 vCPU целиком под него.
# Бот занимает ~56 МБ в покое, так что запас большой. Значения ниже
# подняты умеренно: узкое место здесь — лимиты источников и Telegram,
# а не сервер, и гнать параллелизм ради самого числа смысла нет.
# ============================================================
# SOURCE_FETCH_CONCURRENCY=12     # сбор ждёт сеть, а не ядра
# NEWS_PER_SOURCE=8
# QUEUE_MAX_SIZE=60               # пороги backpressure подтянутся сами (2/3 и 9/10)
# SENT_LINKS_MAX=15000            # длиннее память дедупа
# IMAGE_BYTES_CACHE_MAX_MB=128    # при 2 ГБ можно втрое щедрее умолчания
# LOG_MAX_MB=20
# LOG_BACKUP_COUNT=5

# Сколько ждать перед возвратом к основному провайдеру после временного
# отказа (нет свободной мощности). Правки переменных такой отказ не требует.
# LLM_PRIMARY_RETRY_SEC=1800

# ============================================================
# ЯЗЫКОВАЯ МОДЕЛЬ. Без неё бот работает, но посты идут без
# перевода, тегов и отсева — через DeepL/Google.
# ============================================================
# Провайдер: mistral / groq / gemini / openrouter / orcarouter / nvidia /
# cerebras. Адрес и модель подставятся сами; задать вручную можно ниже.
# LLM_PROVIDER=orcarouter
# LLM_API_KEY=

# Если нужен не тот адрес или не та модель, что в пресете.
# LLM_BASE_URL=https://api.orcarouter.ai/v1
# LLM_MODEL=deepseek/deepseek-v4-flash-free

# Запасной провайдер — отдельный аккаунт и отдельные лимиты. Бесплатные
# тарифы кончаются без предупреждения, и в одиночку бот остаётся без модели.
# LLM_FALLBACK_PROVIDER=mistral
# LLM_FALLBACK_API_KEY=

# Третий провайдер. Используется и как быстрый маршрут для простых задач,
# и как последняя страховка, когда первые два молчат.
# LLM_FAST_PROVIDER=groq
# LLM_FAST_API_KEY=
# LLM_FAST_MODEL=openai/gpt-oss-20b

# Потолки. Дневной лимит вызовов и пауза между запросами: у бесплатных
# тарифов ограничен и темп (запросов в минуту), и суточное число.
# LLM_DAILY_LIMIT=900
# LLM_MIN_INTERVAL=1.2
# LLM_TIMEOUT=30

# Если настроенная модель не отвечает или вернула неразбираемый ответ,
# новость остаётся в очереди. Отсрочка и число попыток переживают перезапуск.
# После трёх отсрочек доступен обычный перевод DeepL/Google.
# LLM_DEFER_MAX_ATTEMPTS=3
# LLM_DEFER_RETRY_SEC=300

# Сколько новостей уходит в модель ОДНИМ запросом. Это главный способ уложиться
# в бесплатные пулы: они общие на всех пользователей сервиса и отвечают 429
# одновременно у всех провайдеров, поэтому «одна новость — один вызов» они
# просто не выдерживают. 4 новости в пачке — это вчетверо меньше запросов.
# Значение 1 возвращает старое поведение; то же делает FEATURE_LLM_BATCHING=0.
# Больше 4-5 ставить не стоит: длинную пачку модель начинает путать и обрывать.
# LLM_BATCH_SIZE=4
# LLM_BATCH_ITEM_TEXT_MAX=2000

# Кеш разборов: тот же материал приходит с зеркал ленты и возвращается в
# очередь после ошибки отправки — второй раз за него платить незачем.
# Живёт только в памяти процесса.
# LLM_EDITORIAL_CACHE_MAX=400
# LLM_EDITORIAL_CACHE_TTL_SEC=21600

# Перевод через DeepL. Без ключа используется Google — бесплатно и без учёта.
# DEEPL_API_KEY=

# Бот сам подбирает паузу между запросами под каждого провайдера: получил
# 429 — сбавил, отвечает стабильно — осторожно вернул обратно. Это потолок
# такой паузы и максимум, который он готов прождать внутри одного вызова,
# прежде чем отдать пост без обогащения.
# LLM_PACE_MAX_SEC=60
# LLM_INLINE_RETRY_MAX_SEC=20

# Запасные модели у ТОГО ЖЕ провайдера, через запятую. Бесплатные модели у
# роутеров теряют мощность и исчезают из каталога поодиночке, а ключ при этом
# остаётся рабочим — заводить ради этого второй аккаунт незачем. Бот сначала
# переберёт этот список на своём ключе и только потом пойдёт к другому
# провайдеру. Живые имена показывает /llmping.
# LLM_MODEL_ALTERNATES=qwen/qwen3.8-27b-free,tencent/hy3-free

# ============================================================
# МОДЕРАЦИЯ ЧАТА. Выключена по умолчанию: включать осознанно и
# только после того, как боту выданы права в чате.
# ============================================================
# FEATURE_CHAT_MODERATION=true

# Сколько раз человек должен принизить одного и того же собеседника, прежде
# чем это перестанет быть спором и станет травлей. Единица здесь означала бы
# наказание за одну колкость.
# MODERATION_BELITTLING_STREAK=3
# MODERATION_BELITTLING_WINDOW_SEC=1800

# Сколько последних решений держать для разбора в /modlog.
# MODERATION_LOG_MAX=50

# Чаты под модерацией. Обычно задавать не нужно — проще вызвать /modhere
# в самом чате. Пусто означает «нигде», даже при включённом флаге:
# добавление бота в чужой чат не должно ничего запускать.
# MODERATION_CHATS=-1001234567890

# Дневной бюджет модели на модерацию — ОТДЕЛЬНЫЙ от новостного.
# Без него одна перепалка съела бы дневной лимит, и бот перестал бы
# обрабатывать новости.
# MODERATION_LLM_DAILY_LIMIT=120

# Флуд: столько сообщений за столько секунд от одного участника.
# MODERATION_FLOOD_MESSAGES=6
# MODERATION_FLOOD_WINDOW_SEC=12

# Сколько последних сообщений держим для контекста (только в памяти).
# MODERATION_CONTEXT_SIZE=12

# Сколько живёт предупреждение.
# MODERATION_WARN_TTL_HOURS=720

# Сколько держим в кеше ответ «этот участник — админ чата». Без кеша каждое
# подозрительное сообщение стоило бы отдельного обращения к Telegram.
# MODERATION_ADMIN_CACHE_SEC=300

# Режим модерации на старте: observe (только докладывает) или active.
# По умолчанию observe — новая функция не должна начинать с наказаний.
# Переключается командой /modmode, значение переживает перезапуск.
# MODERATION_MODE=observe

# Не больше одного наказания на человека за это время. Если модель начнёт
# ошибаться, серия наказаний за минуту хуже одной ошибки.
# MODERATION_ACTION_COOLDOWN_SEC=60
